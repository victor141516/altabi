<Window x:Class="Altabi.SwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altabi" Width="200" Height="140"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False" SizeToContent="Manual"
        Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        SourceInitialized="OnSourceInitialized" Closing="OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F5FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#B8FFFFFF" />
        <SolidColorBrush x:Key="SelectionFill" Color="#3DFFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#60CDFF" />
    </Window.Resources>

    <!-- The window covers the monitor's work area and is transparent; only the backplate and the
         clipped content are visible. Their size is animated in WPF, never by resizing the window.
         The backplate is a translucent tint over the acrylic backdrop window placed behind it. -->
    <Grid x:Name="Stage" VerticalAlignment="Top">
        <Border x:Name="Backplate" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#59202020" CornerRadius="8" />

        <Border x:Name="Root" Padding="14" HorizontalAlignment="Center" VerticalAlignment="Top"
                MouseMove="OnPanelMouseMove" MouseLeftButtonDown="OnPanelMouseDown"
                MouseLeftButtonUp="OnPanelMouseUp">
            <StackPanel>
                <ItemsControl x:Name="AppsList" ItemsSource="{Binding Tiles}" HorizontalAlignment="Center"
                              Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tile" Margin="3" Padding="6,10,6,8" CornerRadius="12" Background="Transparent"
                                    Width="{Binding TileWidth}" Cursor="Hand">
                                <StackPanel>
                                    <Grid HorizontalAlignment="Center"
                                          Width="{Binding IconSize}" Height="{Binding IconSize}">
                                        <Border x:Name="Placeholder" CornerRadius="12" Background="#33FFFFFF">
                                            <Viewbox Margin="10">
                                                <TextBlock Text="{Binding App.Initial}" Foreground="{StaticResource TextPrimary}"
                                                           FontWeight="SemiBold" />
                                            </Viewbox>
                                        </Border>
                                        <Image Source="{Binding App.Icon}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <TextBlock Text="{Binding App.Name}" Margin="0,7,0,0" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding App.HasIcon}" Value="True">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource SelectionFill}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl x:Name="WindowsList" ItemsSource="{Binding Windows}" HorizontalAlignment="Center"
                              Margin="0,12,0,0" Focusable="False" IsTabStop="False"
                              Visibility="{Binding ShowWindows, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- DWM draws the live thumbnail over ThumbSlot, so the selection frame stays outside it. -->
                            <Border x:Name="Frame" Margin="4" Padding="6" CornerRadius="10" BorderThickness="2"
                                    BorderBrush="Transparent" Background="Transparent" Cursor="Hand">
                                <StackPanel>
                                    <Grid x:Name="ThumbSlot" Background="#14FFFFFF"
                                          Width="{Binding ThumbWidth}" Height="{Binding ThumbHeight}">
                                        <Image Source="{Binding App.Icon}" Width="48" Height="48" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding IsMinimized, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Title}" Margin="0,6,0,0" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Width="{Binding ThumbWidth}" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter TargetName="Frame" Property="Background" Value="#22FFFFFF" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
