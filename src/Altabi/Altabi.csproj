<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Altabi</AssemblyName>
    <RootNamespace>Altabi</RootNamespace>
    <Product>Altabi</Product>
    <Description>Application-grouped Alt+Tab replacement for Windows 10 and Windows 11</Description>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon\altabi.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- WPF reads per-monitor DPI awareness from app.manifest; the WinForms-only alternative does not apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The tray loads the multi-size icon from this resource so it can pick the size it needs. -->
    <EmbeddedResource Include="..\..\assets\icon\altabi.ico" LogicalName="Altabi.altabi.ico" />
  </ItemGroup>
</Project>
